# Copy this file to .env and fill in the values: cp .env.example .env

# MongoDB (Docker). Use only letters and numbers in the password, since it
# goes into the connection URL. Generate one with `openssl rand -hex 16`.
MONGO_ROOT_USERNAME=equora
MONGO_ROOT_PASSWORD=
# Port to reach MongoDB from your Mac (for example with MongoDB Compass)
MONGO_HOST_PORT=27018

# Secrets: generate each one with `openssl rand -hex 32`
SESSION_SECRET=
INTERNAL_API_TOKEN=

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Used on first start only, to create the clinic and its first admin account.
# The password must be at least 12 characters. Once you can sign in you can
# change it from "My account" and remove these lines.
INITIAL_CLINIC_NAME=Equora
INITIAL_ADMIN_NAME="Clinic Administrator"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
