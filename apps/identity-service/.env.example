# For running this service on its own with `npm run dev:identity`
# (start MongoDB first, for example with `docker compose up mongo`).
PORT=3003
HOST=127.0.0.1
MONGODB_URI=mongodb://equora:change-me@127.0.0.1:27018/vetflow_identity?authSource=admin
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
COOKIE_SECURE=false
INITIAL_CLINIC_NAME=Equora
INITIAL_ADMIN_NAME="Clinic Administrator"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
